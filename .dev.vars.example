# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
CONTACT_EMAIL=admin@spechawk.ai
POSTING_ENABLED=false

# --- Telegram approval queue (PR-2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Hours before an unapproved draft expires (default 6).
QUEUE_TTL_HOURS=6

